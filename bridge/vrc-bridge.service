[Unit]
Description=VRChat bridge for AstrBot (audio, OSC inputs, state)
After=pipewire-pulse.socket

[Service]
Environment=DISPLAY=:1
Environment=XAUTHORITY=%h/.Xauthority
# This machine's arguments (listen address, inference URLs, ...):
# VRC_BRIDGE_ARGS in ~/.config/vrc-bridge/env (see install.sh).
EnvironmentFile=-%h/.config/vrc-bridge/env
ExecStart=/usr/bin/python3 %h/vrc-bridge/vrc_bridge.py $VRC_BRIDGE_ARGS
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
