+/*!
+ * vrc fork: maps the frame rate control file (XRT_NULL_FPS_FILE), two u32:
+ * the rate asked for and the rate in use.
+ */
+static void
+fps_ctl_init(struct null_compositor *c)
+{
+	const char *path = debug_get_option_fps_file();
+	if (path == NULL || path[0] == '\0') {
+		return;
+	}
+	int fd = open(path, O_RDWR | O_CREAT | O_CLOEXEC, 0666);
+	if (fd < 0 || ftruncate(fd, 8) != 0) {
+		NULL_ERROR(c, "Cannot open the frame rate control '%s'", path);
+		if (fd >= 0) {
+			close(fd);
+		}
+		return;
+	}
+	void *map = mmap(NULL, 8, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	close(fd);
+	if (map == MAP_FAILED) {
+		return;
+	}
+	c->fps_ctl = map;
+	__atomic_store_n(&c->fps_ctl[0], 0, __ATOMIC_RELAXED);
+	__atomic_store_n(&c->fps_ctl[1], c->fps_now, __ATOMIC_RELAXED);
+	NULL_INFO(c, "Frame rate control at '%s' (default %u fps)", path, c->fps_now);
+}
+
+//! vrc fork: follows the rate the control file asks for.
+static void
+fps_ctl_follow(struct null_compositor *c)
+{
+	if (c->fps_ctl == NULL) {
+		return;
+	}
+	uint32_t want = __atomic_load_n(&c->fps_ctl[0], __ATOMIC_RELAXED);
+	if (want == 0 || want > NULL_FPS_MAX) {
+		want = c->fps_default;
+	}
+	if (want == c->fps_now) {
+		return;
+	}
+	u_pc_fake_set_frame_period(c->upc, U_TIME_1S_IN_NS / want);
+	c->settings.frame_interval_ns = U_TIME_1S_IN_NS / want;
+	c->fps_now = want;
+	__atomic_store_n(&c->fps_ctl[1], want, __ATOMIC_RELAXED);
+	NULL_DEBUG(c, "Frame rate now %u fps", want);
+}
